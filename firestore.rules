rules_version = '2';

// TripSync Firestore security rules.
// Tests: firestore_rules_test/ (see README, "Firestore rules").
// NOT published yet: publish once every section below is written.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Shared helpers ----

    function signedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    // Same as Trip.roleOf in the app: the organizer counts as a member
    // even if memberIds doesn't list them.
    function isOrganizer(tripId) {
      return signedIn() && tripData(tripId).organizerId == request.auth.uid;
    }

    function isMember(tripId) {
      return signedIn()
        && (tripData(tripId).organizerId == request.auth.uid
            || request.auth.uid in tripData(tripId).memberIds);
    }

    // ---- trips, inviteCodes (Rose) ----
    // TODO(Rose): rules for trips/{tripId} and inviteCodes/{code}.

    match /trips/{tripId} {

      // ---- itinerary, suggestions (Marina) ----
      // TODO(Marina): rules for the itinerary subcollections.

      // ---- polls (Ella, Story 7) ----
      // Fields: question, options, votes {userId: option}, createdBy,
      // createdAt. See features/voting/data/firestore_poll_repository.dart.
      match /polls/{pollId} {
        function pollFields() {
          return ['question', 'options', 'votes', 'createdBy', 'createdAt'];
        }

        // Option i is a non-empty string, or the list is shorter than i + 1.
        function okOption(options, i) {
          return options.size() <= i
            || (options[i] is string && options[i].size() > 0);
        }

        // The app reads options as List<String>, so a wrong type here would
        // break the poll list for the whole trip. Rules have no loops, so
        // each index is checked by hand, which caps polls at 20 options.
        // Vote values can't be type-checked the same way; only the
        // organizer can write arbitrary votes (members are limited below).
        function validPoll(data) {
          return data.question is string && data.question.size() > 0
            && data.options is list
            && data.options.size() >= 2 && data.options.size() <= 20
            && data.options.toSet().size() == data.options.size()
            && okOption(data.options, 0)
            && okOption(data.options, 1)
            && okOption(data.options, 2)
            && okOption(data.options, 3)
            && okOption(data.options, 4)
            && okOption(data.options, 5)
            && okOption(data.options, 6)
            && okOption(data.options, 7)
            && okOption(data.options, 8)
            && okOption(data.options, 9)
            && okOption(data.options, 10)
            && okOption(data.options, 11)
            && okOption(data.options, 12)
            && okOption(data.options, 13)
            && okOption(data.options, 14)
            && okOption(data.options, 15)
            && okOption(data.options, 16)
            && okOption(data.options, 17)
            && okOption(data.options, 18)
            && okOption(data.options, 19)
            && data.votes is map;
        }

        // Only these keys change between the stored poll and the write.
        function changesOnly(keys) {
          return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(keys);
        }

        allow read: if isMember(tripId);

        // Organizer posts a poll: exact fields, no votes yet, server time.
        allow create: if isOrganizer(tripId)
          && request.resource.data.keys().hasOnly(pollFields())
          && request.resource.data.keys().hasAll(pollFields())
          && validPoll(request.resource.data)
          && request.resource.data.votes.size() == 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // Organizer edits the poll (question, options, votes) or votes.
        // A member only sets their own vote, to an option the poll has.
        allow update: if (isOrganizer(tripId)
            && changesOnly(['question', 'options', 'votes'])
            && validPoll(request.resource.data))
          || (isMember(tripId)
            && changesOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes)
                 .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.votes[request.auth.uid]
                 in resource.data.options);

        // The app has no delete.
        allow delete: if false;
      }

      // ---- expenses (Ella, Story 8) ----
      // Fields: description, amountInCents, paidBy, paidByName, createdAt.
      // See features/expenses/data/firestore_expense_repository.dart.
      match /expenses/{expenseId} {
        function expenseFields() {
          return ['description', 'amountInCents', 'paidBy', 'paidByName',
                  'createdAt'];
        }

        function validExpense(data) {
          return data.description is string && data.description.size() > 0
            && data.amountInCents is int && data.amountInCents > 0;
        }

        allow read: if isMember(tripId);

        // Any member adds an expense they paid, stamped with server time.
        allow create: if isMember(tripId)
          && request.resource.data.keys().hasOnly(expenseFields())
          && request.resource.data.keys().hasAll(expenseFields())
          && validExpense(request.resource.data)
          && request.resource.data.paidBy == request.auth.uid
          && request.resource.data.paidByName is string
          && request.resource.data.createdAt == request.time;

        // Only the payer edits, and only the description and amount.
        allow update: if isMember(tripId)
          && resource.data.paidBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['description', 'amountInCents'])
          && validExpense(request.resource.data);

        // The app has no delete.
        allow delete: if false;
      }
    }
  }
}
